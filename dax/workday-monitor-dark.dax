Workday Monitor SVG Dark =
VAR WorkStartTime = TIME(8, 0, 0)
VAR WorkEndTime = TIME(16, 0, 0)
VAR IsWorkScheduleValid = WorkEndTime > WorkStartTime

-- Warsaw date and time, including CET / CEST
VAR CurrentUtcDateTime = UTCNOW()
VAR CurrentYear = YEAR(CurrentUtcDateTime)
VAR LastDayOfMarch = DATE(CurrentYear, 3, 31)
VAR LastSundayOfMarch = LastDayOfMarch - MOD(WEEKDAY(LastDayOfMarch, 2), 7)
VAR DstStartUtc = LastSundayOfMarch + TIME(1, 0, 0)
VAR LastDayOfOctober = DATE(CurrentYear, 10, 31)
VAR LastSundayOfOctober = LastDayOfOctober - MOD(WEEKDAY(LastDayOfOctober, 2), 7)
VAR DstEndUtc = LastSundayOfOctober + TIME(1, 0, 0)
VAR IsDaylightSavingTime = CurrentUtcDateTime >= DstStartUtc && CurrentUtcDateTime < DstEndUtc
VAR CurrentUtcOffsetHours = IF(IsDaylightSavingTime, 2, 1)
VAR CurrentTimeZoneName = IF(IsDaylightSavingTime, "CEST (UTC+2)", "CET (UTC+1)")
VAR CurrentLocalDateTime = CurrentUtcDateTime + DIVIDE(CurrentUtcOffsetHours, 24)
VAR CurrentLocalDate = DATE(YEAR(CurrentLocalDateTime), MONTH(CurrentLocalDateTime), DAY(CurrentLocalDateTime))
VAR WorkStartDateTime = CurrentLocalDate + WorkStartTime
VAR WorkEndDateTime = CurrentLocalDate + WorkEndTime

-- Working day
VAR IsWeekend = WEEKDAY(CurrentLocalDateTime, 2) >= 6
VAR IsWorkingDay = IsWorkScheduleValid && NOT IsWeekend
VAR WorkdayDurationSeconds = IF(IsWorkScheduleValid, DATEDIFF(WorkStartDateTime, WorkEndDateTime, SECOND), 0)
VAR RawElapsedSeconds = DATEDIFF(WorkStartDateTime, CurrentLocalDateTime, SECOND)
VAR ElapsedSeconds = IF(NOT IsWorkingDay, 0, MAX(0, MIN(WorkdayDurationSeconds, RawElapsedSeconds)))
VAR RemainingSeconds = IF(IsWorkingDay, MAX(0, WorkdayDurationSeconds - ElapsedSeconds), 0)

-- Time labels
VAR WorkdayDurationText =
    FORMAT(QUOTIENT(WorkdayDurationSeconds, 3600), "00") & ":"
        & FORMAT(QUOTIENT(MOD(WorkdayDurationSeconds, 3600), 60), "00") & ":"
        & FORMAT(MOD(WorkdayDurationSeconds, 60), "00")
VAR ElapsedTimeText =
    FORMAT(QUOTIENT(ElapsedSeconds, 3600), "00") & ":"
        & FORMAT(QUOTIENT(MOD(ElapsedSeconds, 3600), 60), "00") & ":"
        & FORMAT(MOD(ElapsedSeconds, 60), "00")
VAR RemainingTimeText =
    FORMAT(QUOTIENT(RemainingSeconds, 3600), "00") & ":"
        & FORMAT(QUOTIENT(MOD(RemainingSeconds, 3600), 60), "00") & ":"
        & FORMAT(MOD(RemainingSeconds, 60), "00")

-- Progress and status
VAR WorkdayProgress = IF(IsWorkingDay, MIN(1, MAX(0, DIVIDE(ElapsedSeconds, WorkdayDurationSeconds, 0))))
VAR HasProgress = NOT ISBLANK(WorkdayProgress)
VAR RemainingWorkday = IF(HasProgress, 1 - WorkdayProgress)
VAR WorkdayProgressText = IF(HasProgress, FORMAT(WorkdayProgress, "0.0%"), "-")
VAR RemainingWorkdayText = IF(HasProgress, FORMAT(RemainingWorkday, "0.0%"), "-")
VAR WorkdayStatus =
    SWITCH(
        TRUE(),
        NOT IsWorkScheduleValid, "Invalid work schedule",
        IsWeekend, "Weekend - no working hours scheduled",
        CurrentLocalDateTime < WorkStartDateTime, "Before work",
        CurrentLocalDateTime < WorkEndDateTime, "Work in progress",
        "Workday completed"
    )

-- CV Dark palette
VAR PageBackgroundColor = "#07110F"
VAR CardBackgroundColor = "#0C1715"
VAR PrimaryTextColor = "#F1F8F6"
VAR SecondaryTextColor = "#C5D8D3"
VAR MutedTextColor = "#91AAA4"
VAR BorderColor = "#344E49"
VAR DividerColor = "#344E49"
VAR FabricDarkColor = "#61E6BD"
VAR FabricDeepColor = "#062F2B"
VAR FabricGreenColor = "#24C99B"
VAR FabricTealColor = "#129F8C"
VAR FabricMintColor = "#67E8BC"
VAR FabricAquaColor = "#45D5C0"
VAR FabricPaleColor = "#123B35"
VAR FabricSoftColor = "#174B43"
VAR PowerBIColor = "#F2C94C"
VAR PowerBIDarkColor = "#F4D65E"
VAR PowerBIPaleColor = "#3A3215"
VAR WhiteColor = "#F3FAF8"

-- Cards derived from the CV Dark palette
VAR DateTimeCardColor = "#123B35"
VAR WorkStartCardColor = "#123B35"
VAR WorkEndCardColor = "#103833"
VAR DurationCardColor = "#3A3215"
VAR RemainingCardColor = "#102A26"
VAR DateTimeBorderColor = FabricMintColor
VAR WorkStartBorderColor = FabricGreenColor
VAR WorkEndBorderColor = FabricAquaColor
VAR DurationBorderColor = PowerBIColor
VAR RemainingBorderColor = FabricMintColor
VAR ProgressTrackColor = "#28453F"

-- Dynamic status colors kept inside the same Fabric-inspired family
VAR MainColor =
    SWITCH(
        TRUE(),
        NOT IsWorkScheduleValid, "#F07183",
        IsWeekend, FabricTealColor,
        CurrentLocalDateTime < WorkStartDateTime, "#45D5C0",
        CurrentLocalDateTime < WorkEndDateTime, FabricGreenColor,
        FabricDarkColor
    )
VAR StatusBackgroundColor =
    SWITCH(
        TRUE(),
        NOT IsWorkScheduleValid, "#3B1E25",
        IsWeekend, "#103833",
        CurrentLocalDateTime < WorkStartDateTime, FabricPaleColor,
        CurrentLocalDateTime < WorkEndDateTime, FabricSoftColor,
        "#11352E"
    )
VAR StatusBorderColor =
    SWITCH(
        TRUE(),
        NOT IsWorkScheduleValid, "#D95F72",
        IsWeekend, FabricAquaColor,
        CurrentLocalDateTime < WorkStartDateTime, FabricMintColor,
        CurrentLocalDateTime < WorkEndDateTime, FabricGreenColor,
        FabricTealColor
    )
VAR StatusIcon =
    SWITCH(
        TRUE(),
        NOT IsWorkScheduleValid, "!",
        IsWeekend, "Z",
        CurrentLocalDateTime < WorkStartDateTime, "i",
        CurrentLocalDateTime < WorkEndDateTime, ">",
        "OK"
    )

-- Progress bar
VAR ProgressBarX = 36
VAR ProgressBarY = 480
VAR ProgressBarWidth = 568
VAR ProgressBarHeight = 20
VAR ProgressWidth = IF(HasProgress, ROUND(ProgressBarWidth * WorkdayProgress, 0), 0)

-- Generated timestamp in pure DAX
-- This is the measure evaluation time, not semantic model refresh metadata.
VAR GeneratedLocalDateTime = CurrentLocalDateTime
VAR GeneratedText =
    FORMAT(GeneratedLocalDateTime, "dd MMM yyyy HH:mm:ss")
        & " "
        & IF(IsDaylightSavingTime, "CEST", "CET")

VAR SVG =
    "<svg xmlns='http://www.w3.org/2000/svg' width='640' height='720' viewBox='0 0 640 720'>"
        & "<defs>"
        & "<linearGradient id='pageBg' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#07110F'/><stop offset='100%' stop-color='#0B1C19'/></linearGradient>"
        & "<linearGradient id='topAccent' x1='0' y1='0' x2='1' y2='0'><stop offset='0%' stop-color='#61E6BD'/><stop offset='45%' stop-color='#24C99B'/><stop offset='100%' stop-color='#67E8BC'/></linearGradient>"
        & "<filter id='cardShadow' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='5' stdDeviation='9' flood-color='#000000' flood-opacity='.14'/></filter>"
        & "</defs>"
        & "<rect x='0' y='0' width='640' height='720' fill='url(#pageBg)'/>"
        & "<rect x='16' y='16' width='608' height='688' rx='20' fill='" & CardBackgroundColor & "' stroke='" & BorderColor & "' stroke-width='1.5' filter='url(#cardShadow)'/>"
        & "<rect x='16' y='16' width='608' height='8' rx='4' fill='url(#topAccent)'/>"

        -- Header
        & "<rect x='36' y='48' width='48' height='48' rx='12' fill='" & StatusBackgroundColor & "' stroke='" & StatusBorderColor & "' stroke-width='1.5'/>"
        & "<text x='60' y='79' text-anchor='middle' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='" & MainColor & "'>" & StatusIcon & "</text>"
        & "<text x='104' y='68' font-family='Segoe UI,Arial' font-size='26' font-weight='700' letter-spacing='.3' fill='" & PrimaryTextColor & "'>WORKDAY MONITOR</text>"
        & "<text x='104' y='90' font-family='Segoe UI,Arial' font-size='13' font-weight='600' fill='" & SecondaryTextColor & "'>Warsaw work schedule</text>"

        -- Current date and time
        & "<rect x='36' y='120' width='568' height='92' rx='14' fill='" & DateTimeCardColor & "' stroke='" & DateTimeBorderColor & "' stroke-width='1.5'/>"
        & "<text x='56' y='150' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>CURRENT DATE</text>"
        & "<text x='56' y='181' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='" & PrimaryTextColor & "'>" & FORMAT(CurrentLocalDateTime, "dd MMM yyyy") & "</text>"
        & "<line x1='320' y1='138' x2='320' y2='194' stroke='" & DateTimeBorderColor & "'/>"
        & "<text x='344' y='150' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>CURRENT TIME</text>"
        & "<text x='344' y='181' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='" & PrimaryTextColor & "'>" & FORMAT(CurrentLocalDateTime, "HH:mm:ss") & "</text>"
        & "<text x='344' y='199' font-family='Segoe UI,Arial' font-size='11' font-weight='600' fill='" & SecondaryTextColor & "'>" & CurrentTimeZoneName & "</text>"

        -- Schedule cards
        & "<text x='36' y='250' font-family='Segoe UI,Arial' font-size='15' font-weight='700' fill='" & PrimaryTextColor & "'>WORK SCHEDULE</text>"
        & "<rect x='36' y='268' width='176' height='92' rx='14' fill='" & WorkStartCardColor & "' stroke='" & WorkStartBorderColor & "' stroke-width='1.5'/>"
        & "<text x='52' y='296' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>WORK START</text>"
        & "<text x='52' y='330' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='" & PrimaryTextColor & "'>" & FORMAT(WorkStartDateTime, "HH:mm:ss") & "</text>"
        & "<rect x='232' y='268' width='176' height='92' rx='14' fill='" & WorkEndCardColor & "' stroke='" & WorkEndBorderColor & "' stroke-width='1.5'/>"
        & "<text x='248' y='296' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>WORK END</text>"
        & "<text x='248' y='330' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='" & PrimaryTextColor & "'>" & FORMAT(WorkEndDateTime, "HH:mm:ss") & "</text>"
        & "<rect x='428' y='268' width='176' height='92' rx='14' fill='" & DurationCardColor & "' stroke='" & DurationBorderColor & "' stroke-width='1.5'/>"
        & "<text x='444' y='296' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>DURATION</text>"
        & "<text x='444' y='330' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='" & PowerBIDarkColor & "'>" & WorkdayDurationText & "</text>"

        -- Elapsed and remaining
        & "<rect x='36' y='380' width='274' height='70' rx='14' fill='" & StatusBackgroundColor & "' stroke='" & StatusBorderColor & "' stroke-width='1.5'/>"
        & "<text x='54' y='407' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>ELAPSED TIME</text>"
        & "<text x='54' y='435' font-family='Segoe UI,Arial' font-size='23' font-weight='700' fill='" & MainColor & "'>" & ElapsedTimeText & "</text>"
        & "<rect x='330' y='380' width='274' height='70' rx='14' fill='" & RemainingCardColor & "' stroke='" & RemainingBorderColor & "' stroke-width='1.5'/>"
        & "<text x='348' y='407' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>REMAINING TIME</text>"
        & "<text x='348' y='435' font-family='Segoe UI,Arial' font-size='23' font-weight='700' fill='" & PrimaryTextColor & "'>" & RemainingTimeText & "</text>"

        -- Progress
        & "<text x='36' y='474' font-family='Segoe UI,Arial' font-size='13' font-weight='600' fill='" & PrimaryTextColor & "'>Workday progress</text>"
        & "<text x='604' y='474' text-anchor='end' font-family='Segoe UI,Arial' font-size='15' font-weight='700' fill='" & MainColor & "'>" & WorkdayProgressText & "</text>"
        & "<rect x='" & ProgressBarX & "' y='" & ProgressBarY & "' width='" & ProgressBarWidth & "' height='" & ProgressBarHeight & "' rx='10' fill='" & ProgressTrackColor & "'/>"
        & IF(ProgressWidth > 0, "<rect x='" & ProgressBarX & "' y='" & ProgressBarY & "' width='" & ProgressWidth & "' height='" & ProgressBarHeight & "' rx='10' fill='" & MainColor & "'/>", "")
        & "<text x='36' y='526' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>Progress: " & WorkdayProgressText & "</text>"
        & "<text x='604' y='526' text-anchor='end' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>Remaining: " & RemainingWorkdayText & "</text>"

        -- Status
        & "<rect x='36' y='550' width='568' height='64' rx='14' fill='" & StatusBackgroundColor & "' stroke='" & StatusBorderColor & "' stroke-width='1.5'/>"
        & "<circle cx='66' cy='582' r='16' fill='" & MainColor & "'/>"
        & "<text x='66' y='587' text-anchor='middle' font-family='Segoe UI,Arial' font-size='11' font-weight='700' fill='" & WhiteColor & "'>" & StatusIcon & "</text>"
        & "<text x='94' y='576' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>STATUS</text>"
        & "<text x='94' y='598' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='" & PrimaryTextColor & "'>" & WorkdayStatus & "</text>"

        -- Generated timestamp footer
        & "<line x1='36' y1='640' x2='604' y2='640' stroke='" & DividerColor & "'/>"
        & "<text x='36' y='668' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & MutedTextColor & "'>GENERATED</text>"
        & "<text x='604' y='668' text-anchor='end' font-family='Segoe UI,Arial' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>" & GeneratedText & "</text>"
        & "</svg>"

RETURN
    "data:image/svg+xml;utf8,"
        & SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(SVG, "#", "%23"),
                        "%", "%25"
                    ),
                    "%2523", "%23"
                ),
                "<", "%3C"
            ),
            ">", "%3E"
        )
