Professional Profile SVG Light =
VAR CurrentDate = TODAY()
VAR PBIStartDate = DATE(2018, 9, 1)
VAR PBITotalMonths = MAX(0, DATEDIFF(PBIStartDate, CurrentDate, MONTH))
VAR PBIExperienceText = QUOTIENT(PBITotalMonths, 12) & "y " & MOD(PBITotalMonths, 12) & "m"
VAR FabricStartDate = DATE(2026, 6, 15)
VAR FabricHasStarted = CurrentDate >= FabricStartDate
VAR FabricTotalMonths = IF(FabricHasStarted, MAX(0, DATEDIFF(FabricStartDate, CurrentDate, MONTH)), 0)
VAR FabricExperienceText = IF(FabricHasStarted, QUOTIENT(FabricTotalMonths, 12) & "y " & MOD(FabricTotalMonths, 12) & "m", "Not started")

-- Warsaw CET / CEST generated timestamp, pure DAX
VAR GeneratedUtc = UTCNOW()
VAR GeneratedYear = YEAR(GeneratedUtc)
VAR LastDayOfMarch = DATE(GeneratedYear, 3, 31)
VAR LastSundayOfMarch = LastDayOfMarch - MOD(WEEKDAY(LastDayOfMarch, 2), 7)
VAR DstStartUtc = LastSundayOfMarch + TIME(1, 0, 0)
VAR LastDayOfOctober = DATE(GeneratedYear, 10, 31)
VAR LastSundayOfOctober = LastDayOfOctober - MOD(WEEKDAY(LastDayOfOctober, 2), 7)
VAR DstEndUtc = LastSundayOfOctober + TIME(1, 0, 0)
VAR IsDst = GeneratedUtc >= DstStartUtc && GeneratedUtc < DstEndUtc
VAR UtcOffsetHours = IF(IsDst, 2, 1)
VAR TimeZoneName = IF(IsDst, "CEST", "CET")
VAR GeneratedLocal = GeneratedUtc + DIVIDE(UtcOffsetHours, 24)
VAR GeneratedTimestamp = FORMAT(GeneratedLocal, "dd MMM yyyy HH:mm:ss") & " " & TimeZoneName

-- Theme
VAR WhiteColor = "#FFFFFF"
VAR MainTextColor = "#15211F"
VAR SecondaryTextColor = "#435B56"
VAR MutedTextColor = "#71837F"
VAR DividerColor = "#CCD8D5"
VAR FabricDarkColor = "#075F57"
VAR FabricDeepColor = "#043F3B"
VAR FabricGreenColor = "#27B98C"
VAR FabricTealColor = "#078F7F"
VAR FabricMintColor = "#73E2B2"
VAR FabricAquaColor = "#61DFCC"
VAR FabricPaleColor = "#E6F8F1"
VAR FabricSoftColor = "#CFF3E6"
VAR PowerBIColor = "#F2C94C"
VAR PowerBIDarkColor = "#725A00"
VAR PowerBIPaleColor = "#FFF7D6"

-- Photo embedded directly in DAX, no Power Query and no external URL
VAR PhotoDataUri = "data:image/jpeg;base64,"

VAR SVG =
    "<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='1180' viewBox='0 0 1000 1180'>"
    & "<defs>"
    & "<linearGradient id='bg' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#EAF2F0'/><stop offset='100%' stop-color='#DDEAE7'/></linearGradient>"
    & "<linearGradient id='side' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#064F48'/><stop offset='48%' stop-color='#078F7F'/><stop offset='100%' stop-color='#65E0B2'/></linearGradient>"
    & "<linearGradient id='accent' x1='0' y1='0' x2='1' y2='0'><stop offset='0%' stop-color='#075F57'/><stop offset='45%' stop-color='#27B98C'/><stop offset='100%' stop-color='#73E2B2'/></linearGradient>"
    & "<linearGradient id='panel' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#F1FCF8'/><stop offset='100%' stop-color='#CFF3E6'/></linearGradient>"
    & "<filter id='shadow' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='7' stdDeviation='12' flood-color='#193D36' flood-opacity='.16'/></filter>"
    & "<filter id='soft' x='-30%' y='-30%' width='160%' height='160%'><feDropShadow dx='0' dy='4' stdDeviation='6' flood-color='#033C36' flood-opacity='.22'/></filter>"
    & "<clipPath id='photoClip'><circle cx='173' cy='156' r='74'/></clipPath>"
    & "</defs>"
    & "<rect width='1000' height='1180' fill='url(#bg)'/>"
    & "<rect x='24' y='24' width='952' height='1132' rx='18' fill='#FFFFFF' filter='url(#shadow)'/>"
    & "<path d='M42 24H322V1156H42Q24 1156 24 1138V42Q24 24 42 24Z' fill='url(#side)'/>"
    & "<path d='M24 24H322V115C249 102 179 112 115 145C72 167 43 196 24 227Z' fill='#73E2B2' opacity='.42'/>"
    & "<path d='M24 174C90 125 175 107 286 126L322 132V215C236 202 162 217 99 260C66 282 41 308 24 339Z' fill='#61DFCC' opacity='.31'/>"
    & "<path d='M24 312C88 270 165 251 255 263L322 272V346C238 334 162 350 101 390C68 411 42 438 24 469Z' fill='#043F3B' opacity='.28'/>"

    -- Embedded circular photo
    & "<circle cx='173' cy='156' r='82' fill='#FFFFFF' opacity='.98' filter='url(#soft)'/>"
    & "<image href='" & PhotoDataUri & "' x='99' y='82' width='148' height='148' preserveAspectRatio='xMidYMid slice' clip-path='url(#photoClip)'/>"
    & "<circle cx='173' cy='156' r='74' fill='none' stroke='#FFFFFF' stroke-width='4'/>"

    -- Sidebar identity
    & "<text x='173' y='280' text-anchor='middle' font-family='Segoe UI,Arial' font-size='28' font-weight='700' fill='#FFFFFF'>KAMIL SOSZKA</text>"
    & "<text x='173' y='308' text-anchor='middle' font-family='Segoe UI,Arial' font-size='15' font-weight='700' letter-spacing='1.2' fill='#D9F4EC'>AI-DRIVEN SOLUTION</text>"
    & "<text x='173' y='327' text-anchor='middle' font-family='Segoe UI,Arial' font-size='15' font-weight='700' letter-spacing='1.2' fill='#D9F4EC'>ARCHITECT</text>"

    -- Sidebar profile
    & "<text x='58' y='387' font-family='Segoe UI,Arial' font-size='18' font-weight='700' fill='#FFFFFF'>PROFILE</text>"
    & "<line x1='58' y1='400' x2='288' y2='400' stroke='#D9F4EC' opacity='.58'/>"
    & "<text x='58' y='430' font-family='Segoe UI,Arial' font-size='15' fill='#D9F4EC'>Power BI</text>"
    & "<text x='58' y='453' font-family='Segoe UI,Arial' font-size='15' fill='#D9F4EC'>Microsoft Fabric</text>"
    & "<text x='58' y='476' font-family='Segoe UI,Arial' font-size='15' fill='#D9F4EC'>Data Engineering</text>"
    & "<text x='58' y='499' font-family='Segoe UI,Arial' font-size='15' fill='#D9F4EC'>AI Solutions</text>"
    & "<text x='58' y='522' font-family='Segoe UI,Arial' font-size='15' fill='#D9F4EC'>Decision Support Systems</text>"

    -- Education
    & "<text x='58' y='578' font-family='Segoe UI,Arial' font-size='18' font-weight='700' fill='#FFFFFF'>EDUCATION</text>"
    & "<line x1='58' y1='591' x2='288' y2='591' stroke='#D9F4EC' opacity='.58'/>"
    & "<circle cx='75' cy='629' r='17' fill='#FFFFFF'/><text x='75' y='634' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13' font-weight='700' fill='#075F57'>PhD</text>"
    & "<text x='105' y='622' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#FFFFFF'>Decision Support</text>"
    & "<text x='105' y='641' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#FFFFFF'>Systems</text>"

    -- Certifications
    & "<text x='58' y='700' font-family='Segoe UI,Arial' font-size='18' font-weight='700' fill='#FFFFFF'>CERTIFICATIONS</text>"
    & "<line x1='58' y1='713' x2='288' y2='713' stroke='#D9F4EC' opacity='.58'/>"
    & "<circle cx='73' cy='750' r='11' fill='#FFFFFF'/><path d='M68 750L72 754L79 746' fill='none' stroke='#075F57' stroke-width='2'/><text x='97' y='747' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#FFFFFF'>PL-300</text><text x='97' y='765' font-family='Segoe UI,Arial' font-size='13.5' fill='#D9F4EC'>Power BI Data Analyst</text>"
    & "<circle cx='73' cy='805' r='11' fill='#FFFFFF'/><path d='M68 805L72 809L79 801' fill='none' stroke='#075F57' stroke-width='2'/><text x='97' y='802' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#FFFFFF'>DP-600</text><text x='97' y='820' font-family='Segoe UI,Arial' font-size='13.5' fill='#D9F4EC'>Fabric Analytics Engineer</text>"
    & "<circle cx='73' cy='860' r='11' fill='#FFFFFF'/><path d='M68 860L72 864L79 856' fill='none' stroke='#075F57' stroke-width='2'/><text x='97' y='857' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#FFFFFF'>DP-700</text><text x='97' y='875' font-family='Segoe UI,Arial' font-size='13.5' fill='#D9F4EC'>Fabric Data Engineer</text>"
    & "<circle cx='73' cy='915' r='11' fill='#FFFFFF'/><path d='M68 915L72 919L79 911' fill='none' stroke='#075F57' stroke-width='2'/><text x='97' y='912' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#FFFFFF'>DP-800</text><text x='97' y='930' font-family='Segoe UI,Arial' font-size='13.5' fill='#D9F4EC'>SQL AI Developer</text>"

    -- Core stack
    & "<text x='58' y='990' font-family='Segoe UI,Arial' font-size='18' font-weight='700' fill='#FFFFFF'>CORE STACK</text>"
    & "<line x1='58' y1='1003' x2='288' y2='1003' stroke='#D9F4EC' opacity='.58'/>"
    & "<rect x='58' y='1026' width='65' height='25' rx='12.5' fill='#FFFFFF'/><text x='90.5' y='1043' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13.5' font-weight='700' fill='#075F57'>DAX</text>"
    & "<rect x='132' y='1026' width='69' height='25' rx='12.5' fill='#FFFFFF'/><text x='166.5' y='1043' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13.5' font-weight='700' fill='#075F57'>PySpark</text>"
    & "<rect x='210' y='1026' width='57' height='25' rx='12.5' fill='#FFFFFF'/><text x='238.5' y='1043' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13.5' font-weight='700' fill='#075F57'>SQL</text>"
    & "<rect x='58' y='1061' width='94' height='25' rx='12.5' fill='#FFFFFF'/><text x='105' y='1078' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13.5' font-weight='700' fill='#075F57'>Power BI</text>"
    & "<rect x='161' y='1061' width='106' height='25' rx='12.5' fill='#FFFFFF'/><text x='214' y='1078' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13.5' font-weight='700' fill='#075F57'>Fabric</text>"

    -- Main header
    & "<rect x='322' y='24' width='654' height='12' fill='url(#accent)'/>"
    & "<text x='368' y='90' font-family='Segoe UI,Arial' font-size='44' font-weight='700' fill='#15211F'>PROFESSIONAL</text>"
    & "<text x='368' y='132' font-family='Segoe UI,Arial' font-size='44' font-weight='700' fill='#15211F'>PROFILE</text>"
    & "<rect x='368' y='154' width='182' height='31' rx='15.5' fill='#E6F8F1'/><text x='459' y='175' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#075F57'>AI-DRIVEN ARCHITECTURE</text>"
    & "<line x1='368' y1='211' x2='930' y2='211' stroke='#CCD8D5' stroke-width='1.5'/>"

    -- Summary
    & "<rect x='368' y='242' width='10' height='29' rx='5' fill='url(#accent)'/><text x='395' y='264' font-family='Segoe UI,Arial' font-size='21' font-weight='700' fill='#15211F'>SUMMARY</text>"
    & "<text x='368' y='303' font-family='Segoe UI,Arial' font-size='16.5' fill='#435B56'><tspan x='368'>Solution architect focused on data platforms, semantic models,</tspan><tspan x='368' dy='22'>advanced analytics and AI-assisted decision support systems.</tspan><tspan x='368' dy='22'>Combines analytical engineering with architecture, automation</tspan><tspan x='368' dy='22'>and responsive information design.</tspan></text>"

    -- Experience heading
    & "<rect x='368' y='410' width='10' height='29' rx='5' fill='url(#accent)'/><text x='395' y='432' font-family='Segoe UI,Arial' font-size='21' font-weight='700' fill='#15211F'>EXPERIENCE</text><line x1='368' y1='450' x2='930' y2='450' stroke='#CCD8D5' stroke-width='1.2'/>"

    -- Power BI
    & "<circle cx='386' cy='494' r='17' fill='#F2C94C'/><text x='386' y='499' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13.5' font-weight='700' fill='#725A00'>BI</text>"
    & "<text x='417' y='489' font-family='Segoe UI,Arial' font-size='18.5' font-weight='700' fill='#15211F'>Power BI experience</text><text x='917' y='490' text-anchor='end' font-family='Segoe UI,Arial' font-size='23' font-weight='700' fill='#725A00'>" & PBIExperienceText & "</text><text x='417' y='510' font-family='Segoe UI,Arial' font-size='14.5' fill='#71837F'>Since September 2018</text>"
    & "<rect x='368' y='533' width='562' height='106' rx='13' fill='#FFF7D6' stroke='#E8D378'/>"
    & "<circle cx='391' cy='561' r='3' fill='#725A00'/><text x='405' y='565' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Advanced DAX engineering</text><circle cx='391' cy='590' r='3' fill='#725A00'/><text x='405' y='594' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Semantic modeling</text><circle cx='391' cy='619' r='3' fill='#725A00'/><text x='405' y='623' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Decision support systems</text>"
    & "<circle cx='670' cy='561' r='3' fill='#725A00'/><text x='684' y='565' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Responsive report design</text><circle cx='670' cy='590' r='3' fill='#725A00'/><text x='684' y='594' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Dynamic SVG visualizations</text><circle cx='670' cy='619' r='3' fill='#725A00'/><text x='684' y='623' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Analytical automation</text>"

    -- Fabric
    & "<circle cx='386' cy='687' r='17' fill='#27B98C'/><text x='386' y='692' text-anchor='middle' font-family='Segoe UI,Arial' font-size='13' font-weight='700' fill='#FFFFFF'>MF</text>"
    & "<text x='417' y='682' font-family='Segoe UI,Arial' font-size='18.5' font-weight='700' fill='#15211F'>Microsoft Fabric experience</text><text x='917' y='683' text-anchor='end' font-family='Segoe UI,Arial' font-size='23' font-weight='700' fill='#075F57'>" & FabricExperienceText & "</text><text x='417' y='703' font-family='Segoe UI,Arial' font-size='14.5' fill='#71837F'>Since June 2026</text>"
    & "<rect x='368' y='726' width='562' height='106' rx='13' fill='url(#panel)' stroke='#73E2B2'/>"
    & "<circle cx='391' cy='754' r='3' fill='#075F57'/><text x='405' y='758' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>PySpark and SQL</text><circle cx='391' cy='783' r='3' fill='#075F57'/><text x='405' y='787' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>ETL and ELT pipelines</text><circle cx='391' cy='812' r='3' fill='#075F57'/><text x='405' y='816' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Data platform integration</text>"
    & "<circle cx='670' cy='754' r='3' fill='#075F57'/><text x='684' y='758' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Fabric analytics engineering</text><circle cx='670' cy='783' r='3' fill='#075F57'/><text x='684' y='787' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Enterprise architecture</text><circle cx='670' cy='812' r='3' fill='#075F57'/><text x='684' y='816' font-family='Segoe UI,Arial' font-size='15.5' fill='#435B56'>Legacy system modernization</text>"

    -- Skills
    & "<rect x='368' y='877' width='10' height='29' rx='5' fill='url(#accent)'/><text x='395' y='899' font-family='Segoe UI,Arial' font-size='21' font-weight='700' fill='#15211F'>SKILL HIGHLIGHTS</text><line x1='368' y1='917' x2='930' y2='917' stroke='#CCD8D5'/>"
    & "<circle cx='382' cy='951' r='5' fill='#27B98C'/><text x='401' y='956' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#15211F'>Analytics</text><text x='401' y='978' font-family='Segoe UI,Arial' font-size='14.5' fill='#435B56'>Power BI, advanced DAX,</text><text x='401' y='995' font-family='Segoe UI,Arial' font-size='14.5' fill='#435B56'>semantic modeling and SVG</text>"
    & "<circle cx='572' cy='951' r='5' fill='#078F7F'/><text x='591' y='956' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#15211F'>Data Engineering</text><text x='591' y='978' font-family='Segoe UI,Arial' font-size='14.5' fill='#435B56'>PySpark, SQL, pipelines,</text><text x='591' y='995' font-family='Segoe UI,Arial' font-size='14.5' fill='#435B56'>ETL and ELT architecture</text>"
    & "<circle cx='778' cy='951' r='5' fill='#73E2B2'/><text x='797' y='956' font-family='Segoe UI,Arial' font-size='16' font-weight='700' fill='#15211F'>AI Solutions</text><text x='797' y='978' font-family='Segoe UI,Arial' font-size='14.5' fill='#435B56'>Copilot, AI architecture</text><text x='797' y='995' font-family='Segoe UI,Arial' font-size='14.5' fill='#435B56'>and decision support</text>"

    -- Footer
    & "<rect x='368' y='1031' width='562' height='55' rx='13' fill='#E6F8F1'/><text x='392' y='1065' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#075F57'>POWER BI  •  FABRIC  •  DAX  •  PYSPARK  •  SQL  •  AI</text>"
    & "<line x1='368' y1='1112' x2='930' y2='1112' stroke='#CCD8D5'/><text x='368' y='1137' font-family='Segoe UI,Arial' font-size='13.5' font-weight='700' fill='#71837F'>GENERATED</text><text x='930' y='1137' text-anchor='end' font-family='Segoe UI,Arial' font-size='14.5' font-weight='600' fill='#435B56'>" & GeneratedTimestamp & "</text>"
    & "</svg>"

RETURN
    "data:image/svg+xml;utf8,"
        & SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(SVG, "%", "%25"),
                        "#", "%23"
                    ),
                    "<", "%3C"
                ),
                ">", "%3E"
            ),
            " ", "%20"
        )
