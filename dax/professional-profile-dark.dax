Professional Profile SVG Dark = 
VAR CurrentDate = TODAY()
VAR PBIStartDate = DATE(2018, 9, 1)
VAR PBITotalMonths = MAX(0, DATEDIFF(PBIStartDate, CurrentDate, MONTH))
VAR PBIYears = QUOTIENT(PBITotalMonths, 12)
VAR PBIRemainingMonths = MOD(PBITotalMonths, 12)
VAR PBIExperienceText = PBIYears & "y " & PBIRemainingMonths & "m"
VAR FabricStartDate = DATE(2026, 6, 15)
VAR FabricHasStarted = CurrentDate >= FabricStartDate
VAR FabricTotalMonths = IF(FabricHasStarted, MAX(0, DATEDIFF(FabricStartDate, CurrentDate, MONTH)), 0)
VAR FabricYears = QUOTIENT(FabricTotalMonths, 12)
VAR FabricRemainingMonths = MOD(FabricTotalMonths, 12)
VAR FabricExperienceText = IF(FabricHasStarted, FabricYears & "y " & FabricRemainingMonths & "m", "Not started")

-- ============================================================
-- LAST REFRESH WITH WARSAW DST
-- ============================================================
VAR LastRefreshUtc = MAX(RefreshInfo[LastRefreshUTC])
VAR HasRefreshTimestamp = NOT ISBLANK(LastRefreshUtc)
VAR RefreshYear = IF(HasRefreshTimestamp, YEAR(LastRefreshUtc), YEAR(CurrentDate))
VAR RefreshLastDayOfMarch = DATE(RefreshYear, 3, 31)
VAR RefreshLastSundayOfMarch = RefreshLastDayOfMarch - MOD(WEEKDAY(RefreshLastDayOfMarch, 2), 7)
VAR RefreshDstStartUtc = RefreshLastSundayOfMarch + TIME(1, 0, 0)
VAR RefreshLastDayOfOctober = DATE(RefreshYear, 10, 31)
VAR RefreshLastSundayOfOctober = RefreshLastDayOfOctober - MOD(WEEKDAY(RefreshLastDayOfOctober, 2), 7)
VAR RefreshDstEndUtc = RefreshLastSundayOfOctober + TIME(1, 0, 0)
VAR IsRefreshDaylightSavingTime =
    HasRefreshTimestamp
        && LastRefreshUtc >= RefreshDstStartUtc
        && LastRefreshUtc < RefreshDstEndUtc
VAR RefreshUtcOffsetHours = IF(IsRefreshDaylightSavingTime, 2, 1)
VAR RefreshTimeZoneName = IF(IsRefreshDaylightSavingTime, "CEST", "CET")
VAR LastRefreshLocalDateTime =
    IF(HasRefreshTimestamp, LastRefreshUtc + DIVIDE(RefreshUtcOffsetHours, 24), BLANK())
VAR RefreshTimestamp =
    IF(
        HasRefreshTimestamp,
        FORMAT(LastRefreshLocalDateTime, "dd MMM yyyy HH:mm:ss") & " " & RefreshTimeZoneName,
        "Not available"
    )

-- ============================================================
-- CV DARK MODE THEME
-- ============================================================
VAR PageBackgroundColor = "#0B1411"
VAR MainCardColor = "#111F1A"
VAR SidebarColor = "#080D0B"
VAR SidebarPanelColor = "#15231E"
VAR SidebarLineColor = "#3C5B50"
VAR SidebarTextColor = "#F4FAF7"
VAR SidebarMutedColor = "#AFC7BE"
VAR PrimaryTextColor = "#F2FAF6"
VAR SecondaryTextColor = "#B5CDC4"
VAR MutedTextColor = "#89A49A"
VAR DividerColor = "#35564A"
VAR MicrosoftBlue = "#54B7ED"
VAR MicrosoftBlueDark = "#75C7F2"
VAR MicrosoftBlueBackground = "#102A39"
VAR PowerBIColor = "#EBCB5A"
VAR PowerBIDarkColor = "#F5D96F"
VAR PowerBIBackgroundColor = "#332D16"
VAR PowerBIBorderColor = "#A98B2E"
VAR FabricColor = "#4DD394"
VAR FabricDarkColor = "#6BE2AA"
VAR FabricBackgroundColor = "#112C21"
VAR FabricBorderColor = "#2F9A69"
VAR AIColor = "#B79CEB"
VAR AIDarkColor = "#CBB7F3"
VAR AIBackgroundColor = "#251E3B"
VAR AIBorderColor = "#8068C5"
VAR CertificationColor = "#4DD394"
VAR CertificationIconTextColor = "#142A23"
VAR WhiteColor = "#FFFFFF"

-- ============================================================
-- SVG: SAME CONTENT, CV-STYLE TWO-COLUMN DARK LAYOUT
-- ============================================================
VAR SVG =
    "<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='820' viewBox='0 0 1000 820'>"
        & "<rect x='0' y='0' width='1000' height='820' fill='" & PageBackgroundColor & "'/>"
        & "<rect x='20' y='20' width='960' height='780' rx='20' fill='" & MainCardColor & "' stroke='" & DividerColor & "' stroke-width='1.5'/>"
        & "<path d='M40 20 H310 V800 H40 Q20 800 20 780 V40 Q20 20 40 20 Z' fill='" & SidebarColor & "'/>"
        & "<rect x='20' y='20' width='290' height='8' rx='4' fill='" & MicrosoftBlue & "'/>"

        -- SIDEBAR: PROFILE
        & "<rect x='62' y='54' width='206' height='164' rx='20' fill='" & SidebarPanelColor & "' stroke='" & SidebarLineColor & "' stroke-width='1.2'/>"
        & "<circle cx='165' cy='125' r='47' fill='" & MicrosoftBlueBackground & "' stroke='" & MicrosoftBlue & "' stroke-width='2'/>"
        & "<text x='165' y='137' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='37' font-weight='700' fill='" & MicrosoftBlue & "'>KS</text>"
        & "<text x='165' y='193' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='11' font-weight='600' fill='" & SidebarMutedColor & "'>POWER BI · FABRIC · AI</text>"

        -- SIDEBAR: EDUCATION
        & "<text x='62' y='260' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='15' font-weight='700' fill='" & SidebarTextColor & "'>EDUCATION</text>"
        & "<line x1='62' y1='271' x2='268' y2='271' stroke='" & SidebarLineColor & "' stroke-width='1.5'/>"
        & "<circle cx='79' cy='307' r='16' fill='" & MicrosoftBlue & "'/>"
        & "<text x='79' y='312' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='10' font-weight='700' fill='" & WhiteColor & "'>PhD</text>"
        & "<text x='106' y='300' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='13' font-weight='700' fill='" & SidebarTextColor & "'>Decision Support</text>"
        & "<text x='106' y='320' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='13' font-weight='700' fill='" & SidebarTextColor & "'>Systems</text>"

        -- SIDEBAR: CERTIFICATIONS
        & "<text x='62' y='370' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='15' font-weight='700' fill='" & SidebarTextColor & "'>CERTIFICATIONS</text>"
        & "<line x1='62' y1='381' x2='268' y2='381' stroke='" & SidebarLineColor & "' stroke-width='1.5'/>"
        & "<circle cx='79' cy='417' r='13' fill='" & CertificationColor & "'/><text x='79' y='421' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='8' font-weight='700' fill='" & CertificationIconTextColor & "'>OK</text>"
        & "<text x='105' y='413' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='14' font-weight='700' fill='" & SidebarTextColor & "'>PL-300</text><text x='105' y='431' font-family='Segoe UI,Arial,sans-serif' font-size='10' fill='" & SidebarMutedColor & "'>Power BI Data Analyst</text>"
        & "<circle cx='79' cy='472' r='13' fill='" & CertificationColor & "'/><text x='79' y='476' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='8' font-weight='700' fill='" & CertificationIconTextColor & "'>OK</text>"
        & "<text x='105' y='468' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='14' font-weight='700' fill='" & SidebarTextColor & "'>DP-600</text><text x='105' y='486' font-family='Segoe UI,Arial,sans-serif' font-size='10' fill='" & SidebarMutedColor & "'>Fabric Analytics Engineer</text>"
        & "<circle cx='79' cy='527' r='13' fill='" & CertificationColor & "'/><text x='79' y='531' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='8' font-weight='700' fill='" & CertificationIconTextColor & "'>OK</text>"
        & "<text x='105' y='523' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='14' font-weight='700' fill='" & SidebarTextColor & "'>DP-700</text><text x='105' y='541' font-family='Segoe UI,Arial,sans-serif' font-size='10' fill='" & SidebarMutedColor & "'>Fabric Data Engineer</text>"
        & "<circle cx='79' cy='582' r='13' fill='" & CertificationColor & "'/><text x='79' y='586' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='8' font-weight='700' fill='" & CertificationIconTextColor & "'>OK</text>"
        & "<text x='105' y='578' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='14' font-weight='700' fill='" & SidebarTextColor & "'>DP-800</text><text x='105' y='596' font-family='Segoe UI,Arial,sans-serif' font-size='10' fill='" & SidebarMutedColor & "'>SQL AI Developer</text>"

        -- SIDEBAR: ORIGINAL CAPABILITY GROUPS
        & "<text x='62' y='650' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='15' font-weight='700' fill='" & SidebarTextColor & "'>FOCUS AREAS</text>"
        & "<line x1='62' y1='661' x2='268' y2='661' stroke='" & SidebarLineColor & "' stroke-width='1.5'/>"
        & "<text x='62' y='691' font-family='Segoe UI,Arial,sans-serif' font-size='12' font-weight='600' fill='" & SidebarMutedColor & "'>Analytics</text>"
        & "<text x='62' y='717' font-family='Segoe UI,Arial,sans-serif' font-size='12' font-weight='600' fill='" & SidebarMutedColor & "'>Data Engineering</text>"
        & "<text x='62' y='743' font-family='Segoe UI,Arial,sans-serif' font-size='12' font-weight='600' fill='" & SidebarMutedColor & "'>AI Solutions</text>"

        -- MAIN: HEADER
        & "<text x='350' y='76' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='38' font-weight='700' fill='" & PrimaryTextColor & "'>KAMIL SOSZKA</text>"
        & "<text x='352' y='106' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='17' font-weight='700' letter-spacing='0.6' fill='" & MicrosoftBlueDark & "'>AI-DRIVEN SOLUTION ARCHITECT</text>"
        & "<text x='352' y='135' font-family='Segoe UI,Arial,sans-serif' font-size='12' font-weight='600' fill='" & SecondaryTextColor & "'>Power BI  |  Microsoft Fabric  |  Data Engineering  |  AI</text>"

        -- MAIN: JOURNEY
        & "<text x='352' y='181' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='15' font-weight='700' fill='" & PrimaryTextColor & "'>MICROSOFT DATA AND AI JOURNEY</text>"
        & "<line x1='352' y1='192' x2='942' y2='192' stroke='" & DividerColor & "' stroke-width='1.5'/>"

        -- POWER BI BLOCK
        & "<circle cx='370' cy='232' r='15' fill='" & PowerBIColor & "'/><text x='370' y='237' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='10' font-weight='700' fill='" & PowerBIDarkColor & "'>BI</text>"
        & "<text x='400' y='223' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='16' font-weight='700' fill='" & PrimaryTextColor & "'>POWER BI EXPERIENCE</text>"
        & "<text x='922' y='225' text-anchor='end' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='22' font-weight='700' fill='" & PowerBIDarkColor & "'>" & PBIExperienceText & "</text>"
        & "<text x='400' y='246' font-family='Segoe UI,Arial,sans-serif' font-size='11' font-weight='600' fill='" & MutedTextColor & "'>Since September 2018</text>"
        & "<circle cx='401' cy='274' r='3' fill='" & PowerBIDarkColor & "'/><text x='414' y='278' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>Power BI and Microsoft Fabric</text>"
        & "<circle cx='401' cy='299' r='3' fill='" & PowerBIDarkColor & "'/><text x='414' y='303' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>Power Query and M</text>"
        & "<circle cx='680' cy='274' r='3' fill='" & PowerBIDarkColor & "'/><text x='693' y='278' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>DAX and advanced modeling</text>"
        & "<circle cx='680' cy='299' r='3' fill='" & PowerBIDarkColor & "'/><text x='693' y='303' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>Fabric Analytics Engineering</text>"

        -- FABRIC BLOCK
        & "<circle cx='370' cy='350' r='15' fill='" & FabricColor & "'/><text x='370' y='355' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='9' font-weight='700' fill='" & WhiteColor & "'>MF</text>"
        & "<text x='400' y='341' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='16' font-weight='700' fill='" & PrimaryTextColor & "'>MICROSOFT FABRIC EXPERIENCE</text>"
        & "<text x='922' y='343' text-anchor='end' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='22' font-weight='700' fill='" & FabricDarkColor & "'>" & FabricExperienceText & "</text>"
        & "<text x='400' y='364' font-family='Segoe UI,Arial,sans-serif' font-size='11' font-weight='600' fill='" & MutedTextColor & "'>Since June 2026</text>"
        & "<circle cx='401' cy='392' r='3' fill='" & FabricColor & "'/><text x='414' y='396' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>PySpark and SQL</text>"
        & "<circle cx='401' cy='417' r='3' fill='" & FabricColor & "'/><text x='414' y='421' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>ETL and ELT pipelines</text>"
        & "<circle cx='680' cy='392' r='3' fill='" & FabricColor & "'/><text x='693' y='396' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>Legacy systems</text>"
        & "<circle cx='680' cy='417' r='3' fill='" & FabricColor & "'/><text x='693' y='421' font-family='Segoe UI,Arial,sans-serif' font-size='12' fill='" & SecondaryTextColor & "'>Enterprise architecture</text>"

        -- MAIN: PROFESSIONAL SUMMARY
        & "<text x='352' y='470' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='15' font-weight='700' fill='" & PrimaryTextColor & "'>PROFESSIONAL SUMMARY</text>"
        & "<line x1='352' y1='481' x2='942' y2='481' stroke='" & DividerColor & "' stroke-width='1.5'/>"

        -- ANALYTICS
        & "<rect x='352' y='501' width='180' height='174' rx='14' fill='" & PowerBIBackgroundColor & "' stroke='" & PowerBIBorderColor & "' stroke-width='1.5'/>"
        & "<rect x='368' y='517' width='40' height='32' rx='9' fill='" & PowerBIColor & "'/><text x='388' y='539' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='13' font-weight='700' fill='" & PowerBIDarkColor & "'>BI</text>"
        & "<text x='419' y='539' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='15' font-weight='700' fill='" & PrimaryTextColor & "'>Analytics</text>"
        & "<circle cx='370' cy='578' r='3' fill='" & PowerBIDarkColor & "'/><text x='383' y='582' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Power BI and Fabric</text>"
        & "<circle cx='370' cy='604' r='3' fill='" & PowerBIDarkColor & "'/><text x='383' y='608' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Power Query and M</text>"
        & "<circle cx='370' cy='630' r='3' fill='" & PowerBIDarkColor & "'/><text x='383' y='634' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Advanced DAX</text>"
        & "<circle cx='370' cy='656' r='3' fill='" & PowerBIDarkColor & "'/><text x='383' y='660' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Semantic modeling</text>"

        -- DATA ENGINEERING
        & "<rect x='548' y='501' width='180' height='174' rx='14' fill='" & FabricBackgroundColor & "' stroke='" & FabricBorderColor & "' stroke-width='1.5'/>"
        & "<rect x='564' y='517' width='40' height='32' rx='9' fill='" & FabricColor & "'/><text x='584' y='539' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='12' font-weight='700' fill='" & WhiteColor & "'>DE</text>"
        & "<text x='615' y='539' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='14' font-weight='700' fill='" & PrimaryTextColor & "'>Data Eng.</text>"
        & "<circle cx='566' cy='578' r='3' fill='" & FabricColor & "'/><text x='579' y='582' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>PySpark and SQL</text>"
        & "<circle cx='566' cy='604' r='3' fill='" & FabricColor & "'/><text x='579' y='608' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>ETL and ELT pipelines</text>"
        & "<circle cx='566' cy='630' r='3' fill='" & FabricColor & "'/><text x='579' y='634' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Legacy systems</text>"
        & "<circle cx='566' cy='656' r='3' fill='" & FabricColor & "'/><text x='579' y='660' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Enterprise architecture</text>"

        -- AI SOLUTIONS
        & "<rect x='744' y='501' width='198' height='174' rx='14' fill='" & AIBackgroundColor & "' stroke='" & AIBorderColor & "' stroke-width='1.5'/>"
        & "<rect x='760' y='517' width='40' height='32' rx='9' fill='" & AIColor & "'/><text x='780' y='539' text-anchor='middle' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='12' font-weight='700' fill='" & WhiteColor & "'>AI</text>"
        & "<text x='811' y='539' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='15' font-weight='700' fill='" & PrimaryTextColor & "'>AI Solutions</text>"
        & "<circle cx='762' cy='578' r='3' fill='" & AIDarkColor & "'/><text x='775' y='582' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Copilot integrations</text>"
        & "<circle cx='762' cy='604' r='3' fill='" & AIDarkColor & "'/><text x='775' y='608' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Azure OpenAI Service</text>"
        & "<circle cx='762' cy='630' r='3' fill='" & AIDarkColor & "'/><text x='775' y='634' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>AI-driven architecture</text>"
        & "<circle cx='762' cy='656' r='3' fill='" & AIDarkColor & "'/><text x='775' y='660' font-family='Segoe UI,Arial,sans-serif' font-size='11' fill='" & PrimaryTextColor & "'>Decision support systems</text>"

        -- FOOTER
        & "<line x1='352' y1='731' x2='942' y2='731' stroke='" & DividerColor & "' stroke-width='1'/>"
        & "<text x='352' y='764' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='10' font-weight='600' letter-spacing='0.4' fill='" & MutedTextColor & "'>LAST REFRESHED</text>"
        & "<text x='942' y='764' text-anchor='end' font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif' font-size='11' font-weight='600' fill='" & SecondaryTextColor & "'>" & RefreshTimestamp & "</text>"
        & "</svg>"

RETURN
    "data:image/svg+xml;utf8,"
        & SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(SVG, "#", "%23"),
                        "%",
                        "%25"
                    ),
                    "%2523",
                    "%23"
                ),
                "<",
                "%3C"
            ),
            ">",
            "%3E"
        )
