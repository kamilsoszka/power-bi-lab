Professional Profile SVG Dark =
VAR CurrentDate = TODAY ()
VAR PBIStartDate = DATE ( 2018, 9, 1 )
VAR PBITotalMonths = MAX ( 0, DATEDIFF ( PBIStartDate, CurrentDate, MONTH ) )
VAR PBIExperienceText = QUOTIENT ( PBITotalMonths, 12 ) & "y " & MOD ( PBITotalMonths, 12 ) & "m"
VAR FabricStartDate = DATE ( 2026, 6, 15 )
VAR FabricHasStarted = CurrentDate >= FabricStartDate
VAR FabricTotalMonths = IF ( FabricHasStarted, MAX ( 0, DATEDIFF ( FabricStartDate, CurrentDate, MONTH ) ), 0 )
VAR FabricExperienceText = IF ( FabricHasStarted, QUOTIENT ( FabricTotalMonths, 12 ) & "y " & MOD ( FabricTotalMonths, 12 ) & "m", "Not started" )

-- Warsaw CET / CEST generated timestamp, pure DAX
VAR GeneratedUtc = UTCNOW ()
VAR GeneratedYear = YEAR ( GeneratedUtc )
VAR LastDayOfMarch = DATE ( GeneratedYear, 3, 31 )
VAR LastSundayOfMarch = LastDayOfMarch - MOD ( WEEKDAY ( LastDayOfMarch, 2 ), 7 )
VAR DstStartUtc = LastSundayOfMarch + TIME ( 1, 0, 0 )
VAR LastDayOfOctober = DATE ( GeneratedYear, 10, 31 )
VAR LastSundayOfOctober = LastDayOfOctober - MOD ( WEEKDAY ( LastDayOfOctober, 2 ), 7 )
VAR DstEndUtc = LastSundayOfOctober + TIME ( 1, 0, 0 )
VAR IsDst = GeneratedUtc >= DstStartUtc && GeneratedUtc < DstEndUtc
VAR UtcOffsetHours = IF ( IsDst, 2, 1 )
VAR TimeZoneName = IF ( IsDst, "CEST", "CET" )
VAR GeneratedLocal = GeneratedUtc + DIVIDE ( UtcOffsetHours, 24 )
VAR GeneratedTimestamp = FORMAT ( GeneratedLocal, "dd MMM yyyy HH:mm:ss" ) & " " & TimeZoneName

-- Theme
VAR WhiteColor = "#F3FAF8"
VAR MainTextColor = "#F1F8F6"
VAR SecondaryTextColor = "#C5D8D3"
VAR MutedTextColor = "#91AAA4"
VAR DividerColor = "#344E49"
VAR FabricDarkColor = "#61E6BD"
VAR FabricDeepColor = "#062F2B"
VAR FabricGreenColor = "#24C99B"
VAR FabricTealColor = "#129F8C"
VAR FabricMintColor = "#67E8BC"
VAR FabricAquaColor = "#45D5C0"
VAR FabricPaleColor = "#123B35"
VAR FabricSoftColor = "#174B43"
VAR PowerBIColor = "#F2C94C"
VAR PowerBIDarkColor = "#F4D65E"
VAR PowerBIPaleColor = "#3A3215"

-- Photo embedded directly in DAX
VAR PhotoDataUri = "data:image/jpeg;base64,"

VAR SVG =
    "<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='1180' viewBox='0 0 1000 1180'>"
    & "<defs>"
    & "<linearGradient id='bg' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#07110F'/><stop offset='100%' stop-color='#0B1C19'/></linearGradient>"
    & "<linearGradient id='side' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#021815'/><stop offset='48%' stop-color='#129F8C'/><stop offset='100%' stop-color='#129F8C'/></linearGradient>"
    & "<linearGradient id='accent' x1='0' y1='0' x2='1' y2='0'><stop offset='0%' stop-color='#61E6BD'/><stop offset='45%' stop-color='#24C99B'/><stop offset='100%' stop-color='#67E8BC'/></linearGradient>"
    & "<linearGradient id='panel' x1='0' y1='0' x2='1' y2='1'><stop offset='0%' stop-color='#0E302B'/><stop offset='100%' stop-color='#174B43'/></linearGradient>"
    & "<filter id='shadow' x='-20%' y='-20%' width='140%' height='140%'><feDropShadow dx='0' dy='7' stdDeviation='12' flood-color='#000000' flood-opacity='.16'/></filter>"
    & "<filter id='soft' x='-30%' y='-30%' width='160%' height='160%'><feDropShadow dx='0' dy='4' stdDeviation='6' flood-color='#000000' flood-opacity='.22'/></filter>"
    & "<clipPath id='photoClip'><circle cx='173' cy='156' r='74'/></clipPath>"
    & "</defs>"
    & "<rect width='1000' height='1180' fill='url(#bg)'/>"
    & "<rect x='24' y='24' width='952' height='1132' rx='18' fill='#0C1715' filter='url(#shadow)'/>"
    & "<path d='M42 24H322V1156H42Q24 1156 24 1138V42Q24 24 42 24Z' fill='url(#side)'/>"
    & "<path d='M24 24H322V115C249 102 179 112 115 145C72 167 43 196 24 227Z' fill='#67E8BC' opacity='.42'/>"
    & "<path d='M24 174C90 125 175 107 286 126L322 132V215C236 202 162 217 99 260C66 282 41 308 24 339Z' fill='#45D5C0' opacity='.31'/>"
    & "<path d='M24 312C88 270 165 251 255 263L322 272V346C238 334 162 350 101 390C68 411 42 438 24 469Z' fill='#062F2B' opacity='.28'/>"

    -- Photo
    & "<circle cx='173' cy='156' r='82' fill='#F3FAF8' opacity='.98' filter='url(#soft)'/>"
    & "<image href='" & PhotoDataUri & "' x='99' y='82' width='148' height='148' preserveAspectRatio='xMidYMid slice' clip-path='url(#photoClip)'/>"
    & "<circle cx='173' cy='156' r='74' fill='none' stroke='#F3FAF8' stroke-width='4'/>"

    -- Sidebar identity and profile
    & "<text x='173' y='280' text-anchor='middle' font-family='Segoe UI,Arial' font-size='29' font-weight='700' fill='#F3FAF8'>KAMIL SOSZKA</text>"
    & "<text x='173' y='308' text-anchor='middle' font-family='Segoe UI,Arial' font-size='16' font-weight='700' letter-spacing='1.2' fill='#D7EEE8'>AI-DRIVEN SOLUTION</text>"
    & "<text x='173' y='327' text-anchor='middle' font-family='Segoe UI,Arial' font-size='16' font-weight='700' letter-spacing='1.2' fill='#D7EEE8'>ARCHITECT</text>"
    & "<text x='58' y='387' font-family='Segoe UI,Arial' font-size='19' font-weight='700' fill='#F3FAF8'>PROFILE</text>"
    & "<line x1='58' y1='400' x2='288' y2='400' stroke='#D7EEE8' opacity='.58'/>"
    & "<text x='58' y='430' font-family='Segoe UI,Arial' font-size='16' fill='#D7EEE8'>Power BI</text>"
    & "<text x='58' y='453' font-family='Segoe UI,Arial' font-size='16' fill='#D7EEE8'>Microsoft Fabric</text>"
    & "<text x='58' y='476' font-family='Segoe UI,Arial' font-size='16' fill='#D7EEE8'>Data Engineering</text>"
    & "<text x='58' y='499' font-family='Segoe UI,Arial' font-size='16' fill='#D7EEE8'>AI Solutions</text>"
    & "<text x='58' y='522' font-family='Segoe UI,Arial' font-size='16' fill='#D7EEE8'>Decision Support Systems</text>"

    -- Education
    & "<text x='58' y='578' font-family='Segoe UI,Arial' font-size='19' font-weight='700' fill='#F3FAF8'>EDUCATION</text>"
    & "<line x1='58' y1='591' x2='288' y2='591' stroke='#D7EEE8' opacity='.58'/>"
    & "<circle cx='75' cy='629' r='17' fill='#F3FAF8'/><text x='75' y='634' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14' font-weight='700' fill='#61E6BD'>PhD</text>"
    & "<text x='105' y='622' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F3FAF8'>Decision Support</text>"
    & "<text x='105' y='641' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F3FAF8'>Systems</text>"

    -- Certifications
    & "<text x='58' y='690' font-family='Segoe UI,Arial' font-size='19' font-weight='700' fill='#F3FAF8'>CERTIFICATIONS</text>"
    & "<line x1='58' y1='703' x2='288' y2='703' stroke='#D7EEE8' opacity='.58'/>"
    & "<circle cx='73' cy='737' r='10' fill='#F3FAF8'/><path d='M68 737L72 741L79 733' fill='none' stroke='#61E6BD' stroke-width='2'/><text x='97' y='734' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F3FAF8'>PL-300</text><text x='97' y='751' font-family='Segoe UI,Arial' font-size='14.5' fill='#D7EEE8'>Power BI Data Analyst</text>"
    & "<circle cx='73' cy='783' r='10' fill='#F3FAF8'/><path d='M68 783L72 787L79 779' fill='none' stroke='#61E6BD' stroke-width='2'/><text x='97' y='780' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F3FAF8'>DP-600</text><text x='97' y='797' font-family='Segoe UI,Arial' font-size='14.5' fill='#D7EEE8'>Fabric Analytics Engineer</text>"
    & "<circle cx='73' cy='829' r='10' fill='#F3FAF8'/><path d='M68 829L72 833L79 825' fill='none' stroke='#61E6BD' stroke-width='2'/><text x='97' y='826' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F3FAF8'>DP-700</text><text x='97' y='843' font-family='Segoe UI,Arial' font-size='14.5' fill='#D7EEE8'>Fabric Data Engineer</text>"
    & "<circle cx='73' cy='875' r='10' fill='#F3FAF8'/><path d='M68 875L72 879L79 871' fill='none' stroke='#61E6BD' stroke-width='2'/><text x='97' y='872' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F3FAF8'>DP-800</text><text x='97' y='889' font-family='Segoe UI,Arial' font-size='14.5' fill='#D7EEE8'>SQL AI Developer</text>"
    & "<circle cx='73' cy='921' r='10' fill='#F3FAF8'/><path d='M68 921L72 925L79 917' fill='none' stroke='#61E6BD' stroke-width='2'/><text x='97' y='918' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F3FAF8'>DP-900</text><text x='97' y='935' font-family='Segoe UI,Arial' font-size='14.5' fill='#D7EEE8'>Azure Data Fundamentals</text>"

    -- Core stack
    & "<text x='58' y='982' font-family='Segoe UI,Arial' font-size='19' font-weight='700' fill='#F3FAF8'>CORE STACK</text>"
    & "<line x1='58' y1='995' x2='288' y2='995' stroke='#D7EEE8' opacity='.58'/>"
    & "<rect x='58' y='1018' width='65' height='25' rx='12.5' fill='#F3FAF8'/><text x='90.5' y='1035' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#61E6BD'>DAX</text>"
    & "<rect x='132' y='1018' width='69' height='25' rx='12.5' fill='#F3FAF8'/><text x='166.5' y='1035' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#61E6BD'>PySpark</text>"
    & "<rect x='210' y='1018' width='57' height='25' rx='12.5' fill='#F3FAF8'/><text x='238.5' y='1035' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#61E6BD'>SQL</text>"
    & "<rect x='58' y='1053' width='94' height='25' rx='12.5' fill='#F3FAF8'/><text x='105' y='1070' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#61E6BD'>Power BI</text>"
    & "<rect x='161' y='1053' width='106' height='25' rx='12.5' fill='#F3FAF8'/><text x='214' y='1070' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#61E6BD'>Fabric</text>"

    -- Main header
    & "<rect x='322' y='24' width='654' height='12' fill='url(#accent)'/>"
    & "<text x='368' y='90' font-family='Segoe UI,Arial' font-size='45' font-weight='700' fill='#F1F8F6'>PROFESSIONAL</text>"
    & "<text x='368' y='132' font-family='Segoe UI,Arial' font-size='45' font-weight='700' fill='#F1F8F6'>PROFILE</text>"
    & "<rect x='368' y='154' width='182' height='31' rx='15.5' fill='#123B35'/><text x='459' y='175' text-anchor='middle' font-family='Segoe UI,Arial' font-size='15.5' font-weight='700' fill='#61E6BD'>AI-DRIVEN ARCHITECTURE</text>"
    & "<line x1='368' y1='211' x2='930' y2='211' stroke='#344E49' stroke-width='1.5'/>"

    -- Summary
    & "<rect x='368' y='242' width='10' height='29' rx='5' fill='url(#accent)'/><text x='395' y='264' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='#F1F8F6'>SUMMARY</text>"
    & "<text x='368' y='303' font-family='Segoe UI,Arial' font-size='17.5' fill='#C5D8D3'><tspan x='368'>Solution architect focused on data platforms, semantic models,</tspan><tspan x='368' dy='22'>advanced analytics and AI-assisted decision support systems.</tspan><tspan x='368' dy='22'>Combines analytical engineering with architecture, automation</tspan><tspan x='368' dy='22'>and responsive information design.</tspan></text>"

    -- Experience
    & "<rect x='368' y='410' width='10' height='29' rx='5' fill='url(#accent)'/><text x='395' y='432' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='#F1F8F6'>EXPERIENCE</text><line x1='368' y1='450' x2='930' y2='450' stroke='#344E49' stroke-width='1.2'/>"
    & "<circle cx='386' cy='494' r='17' fill='#F2C94C'/><text x='386' y='499' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#F4D65E'>BI</text>"
    & "<text x='417' y='489' font-family='Segoe UI,Arial' font-size='19.5' font-weight='700' fill='#F1F8F6'>Power BI experience</text><text x='917' y='490' text-anchor='end' font-family='Segoe UI,Arial' font-size='24' font-weight='700' fill='#F4D65E'>" & PBIExperienceText & "</text><text x='417' y='510' font-family='Segoe UI,Arial' font-size='15.5' fill='#91AAA4'>Since September 2018</text>"
    & "<rect x='368' y='533' width='562' height='106' rx='13' fill='#3A3215' stroke='#8F7725'/>"
    & "<circle cx='391' cy='561' r='3' fill='#F4D65E'/><text x='405' y='565' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Advanced DAX engineering</text><circle cx='391' cy='590' r='3' fill='#F4D65E'/><text x='405' y='594' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Semantic modeling</text><circle cx='391' cy='619' r='3' fill='#F4D65E'/><text x='405' y='623' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Decision support systems</text>"
    & "<circle cx='670' cy='561' r='3' fill='#F4D65E'/><text x='684' y='565' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Responsive report design</text><circle cx='670' cy='590' r='3' fill='#F4D65E'/><text x='684' y='594' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Dynamic SVG visualizations</text><circle cx='670' cy='619' r='3' fill='#F4D65E'/><text x='684' y='623' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Analytical automation</text>"

    -- Fabric
    & "<circle cx='386' cy='687' r='17' fill='#24C99B'/><text x='386' y='692' text-anchor='middle' font-family='Segoe UI,Arial' font-size='14' font-weight='700' fill='#F3FAF8'>MF</text>"
    & "<text x='417' y='682' font-family='Segoe UI,Arial' font-size='19.5' font-weight='700' fill='#F1F8F6'>Microsoft Fabric experience</text><text x='917' y='683' text-anchor='end' font-family='Segoe UI,Arial' font-size='24' font-weight='700' fill='#61E6BD'>" & FabricExperienceText & "</text><text x='417' y='703' font-family='Segoe UI,Arial' font-size='15.5' fill='#91AAA4'>Since June 2026</text>"
    & "<rect x='368' y='726' width='562' height='106' rx='13' fill='url(#panel)' stroke='#67E8BC'/>"
    & "<circle cx='391' cy='754' r='3' fill='#61E6BD'/><text x='405' y='758' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>PySpark and SQL</text><circle cx='391' cy='783' r='3' fill='#61E6BD'/><text x='405' y='787' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>ETL and ELT pipelines</text><circle cx='391' cy='812' r='3' fill='#61E6BD'/><text x='405' y='816' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Data platform integration</text>"
    & "<circle cx='670' cy='754' r='3' fill='#61E6BD'/><text x='684' y='758' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Fabric analytics engineering</text><circle cx='670' cy='783' r='3' fill='#61E6BD'/><text x='684' y='787' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Enterprise architecture</text><circle cx='670' cy='812' r='3' fill='#61E6BD'/><text x='684' y='816' font-family='Segoe UI,Arial' font-size='16.5' fill='#C5D8D3'>Legacy system modernization</text>"

    -- Skills, fixed column widths and no overlap
    & "<rect x='368' y='877' width='10' height='29' rx='5' fill='url(#accent)'/><text x='395' y='899' font-family='Segoe UI,Arial' font-size='22' font-weight='700' fill='#F1F8F6'>SKILL HIGHLIGHTS</text><line x1='368' y1='917' x2='930' y2='917' stroke='#344E49'/>"
    & "<circle cx='382' cy='951' r='5' fill='#24C99B'/><text x='401' y='956' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F1F8F6'>Analytics</text><text x='401' y='978' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>Power BI &amp; DAX</text><text x='401' y='995' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>Semantic models</text><text x='401' y='1012' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>SVG visuals</text>"
    & "<circle cx='572' cy='951' r='5' fill='#129F8C'/><text x='591' y='956' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F1F8F6'>Data Engineering</text><text x='591' y='978' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>PySpark &amp; SQL</text><text x='591' y='995' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>ETL / ELT pipelines</text><text x='591' y='1012' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>Data architecture</text>"
    & "<circle cx='778' cy='951' r='5' fill='#67E8BC'/><text x='797' y='956' font-family='Segoe UI,Arial' font-size='17' font-weight='700' fill='#F1F8F6'>AI Solutions</text><text x='797' y='978' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>Copilot &amp; AI</text><text x='797' y='995' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>Decision support</text><text x='797' y='1012' font-family='Segoe UI,Arial' font-size='15.5' fill='#C5D8D3'>AI architecture</text>"

    -- Footer
    & "<rect x='368' y='1031' width='562' height='55' rx='13' fill='#123B35'/><text x='392' y='1065' font-family='Segoe UI,Arial' font-size='15.5' font-weight='700' fill='#61E6BD'>POWER BI  •  FABRIC  •  DAX  •  PYSPARK  •  SQL  •  AI</text>"
    & "<line x1='368' y1='1112' x2='930' y2='1112' stroke='#344E49'/><text x='368' y='1137' font-family='Segoe UI,Arial' font-size='14.5' font-weight='700' fill='#91AAA4'>GENERATED</text><text x='930' y='1137' text-anchor='end' font-family='Segoe UI,Arial' font-size='15.5' font-weight='600' fill='#C5D8D3'>" & GeneratedTimestamp & "</text>"
    & "</svg>"

RETURN
    "data:image/svg+xml;utf8,"
        & SUBSTITUTE (
            SUBSTITUTE (
                SUBSTITUTE (
                    SUBSTITUTE ( SUBSTITUTE ( SVG, "%", "%25" ), "#", "%23" ),
                    "<",
                    "%3C"
                ),
                ">",
                "%3E"
            ),
            " ",
            "%20"
        )
