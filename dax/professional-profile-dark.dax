Professional Profile SVG Dark = 
VAR CurrentDate =
    TODAY()

-- ============================================================
-- POWER BI EXPERIENCE
-- ============================================================
VAR PBIStartDate =
    DATE(2018, 9, 1)

VAR PBITotalMonths =
    MAX(
        0,
        DATEDIFF(
            PBIStartDate,
            CurrentDate,
            MONTH
        )
    )

VAR PBIYears =
    QUOTIENT(PBITotalMonths, 12)

VAR PBIRemainingMonths =
    MOD(PBITotalMonths, 12)

VAR PBIExperienceText =
    PBIYears & "y "
        & PBIRemainingMonths & "m"

-- ============================================================
-- MICROSOFT FABRIC EXPERIENCE
-- ============================================================
VAR FabricStartDate =
    DATE(2026, 6, 15)

VAR FabricHasStarted =
    CurrentDate >= FabricStartDate

VAR FabricTotalMonths =
    IF(
        FabricHasStarted,
        MAX(
            0,
            DATEDIFF(
                FabricStartDate,
                CurrentDate,
                MONTH
            )
        ),
        0
    )

VAR FabricYears =
    QUOTIENT(FabricTotalMonths, 12)

VAR FabricRemainingMonths =
    MOD(FabricTotalMonths, 12)

VAR FabricExperienceText =
    IF(
        FabricHasStarted,
        FabricYears & "y "
            & FabricRemainingMonths & "m",
        "Not started"
    )

-- ============================================================
-- LAST REFRESH WITH WARSAW DST
-- ============================================================
VAR LastRefreshUtc =
    MAX(RefreshInfo[LastRefreshUTC])

VAR HasRefreshTimestamp =
    NOT ISBLANK(LastRefreshUtc)

VAR RefreshYear =
    IF(
        HasRefreshTimestamp,
        YEAR(LastRefreshUtc),
        YEAR(CurrentDate)
    )

VAR RefreshLastDayOfMarch =
    DATE(RefreshYear, 3, 31)

VAR RefreshLastSundayOfMarch =
    RefreshLastDayOfMarch
        - MOD(
            WEEKDAY(RefreshLastDayOfMarch, 2),
            7
        )

VAR RefreshDstStartUtc =
    RefreshLastSundayOfMarch
        + TIME(1, 0, 0)

VAR RefreshLastDayOfOctober =
    DATE(RefreshYear, 10, 31)

VAR RefreshLastSundayOfOctober =
    RefreshLastDayOfOctober
        - MOD(
            WEEKDAY(RefreshLastDayOfOctober, 2),
            7
        )

VAR RefreshDstEndUtc =
    RefreshLastSundayOfOctober
        + TIME(1, 0, 0)

VAR IsRefreshDaylightSavingTime =
    HasRefreshTimestamp
        && LastRefreshUtc >= RefreshDstStartUtc
        && LastRefreshUtc < RefreshDstEndUtc

VAR RefreshUtcOffsetHours =
    IF(
        IsRefreshDaylightSavingTime,
        2,
        1
    )

VAR RefreshTimeZoneName =
    IF(
        IsRefreshDaylightSavingTime,
        "CEST",
        "CET"
    )

VAR LastRefreshLocalDateTime =
    IF(
        HasRefreshTimestamp,
        LastRefreshUtc
            + DIVIDE(
                RefreshUtcOffsetHours,
                24
            ),
        BLANK()
    )

VAR RefreshTimestamp =
    IF(
        HasRefreshTimestamp,
        FORMAT(
            LastRefreshLocalDateTime,
            "dd MMM yyyy HH:mm:ss"
        )
            & " "
            & RefreshTimeZoneName,
        "Not available"
    )

