               x1='48'
               y1='751'
               x2='942'
               y2='751'
               stroke='" & DividerColor & "'
               stroke-width='1'/>"

        & "<text
               x='48'
               y='778'
               font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif'
               font-size='11'
               font-weight='600'
               letter-spacing='0.4'
               fill='" & MutedTextColor & "'>LAST REFRESHED</text>"

        & "<text
               x='942'
               y='778'
               text-anchor='end'
               font-family='Segoe UI Semibold,Segoe UI,Arial,sans-serif'
               font-size='12'
               font-weight='600'
               fill='" & SecondaryTextColor & "'>"
        & RefreshTimestamp
        & "</text>"

        & "</svg>"

-- ============================================================
-- POWER BI SAFE SVG ENCODING
-- ============================================================
RETURN
    "data:image/svg+xml;utf8,"
        & SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            SVG,
                            "#",
                            "%23"
                        ),
                        "%",
                        "%25"
                    ),
                    "%2523",
                    "%23"
                ),
                "<",
                "%3C"
            ),
            ">",
            "%3E"
        )
